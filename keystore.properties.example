# Copia este archivo a `keystore.properties` (gitignored, nunca se sube) para compilar `assembleRelease` en local con
# la llave real. En el CI no hace falta: .github/workflows/release.yml usa las variables equivalentes (KEYSTORE_PATH,
# KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD) desde GitHub Secrets.
storeFile=/ruta/absoluta/a/velora-release.keystore
storePassword=
keyAlias=velora-release
keyPassword=
