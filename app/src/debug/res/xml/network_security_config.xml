<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo en la versión de desarrollo: permite http:// para hablar con la API que corre en la computadora (10.0.2.2 desde
  el emulador o la IP de la red local, que no se puede listar de antemano). La versión publicable exige HTTPS (ADR-022).
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
